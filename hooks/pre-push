#!/usr/bin/env sh
# Versioned pre-push hook — runs the full gate before a push (i.e. before you
# open or update a PR), NOT on every commit. Install with:
#   git config core.hooksPath hooks
#   chmod +x hooks/pre-push        # Unix only
# Skip for a work-in-progress push with `git push --no-verify`.
set -e

echo "▶ cargo fmt --check"
cargo fmt --all --check

echo "▶ cargo clippy"
cargo clippy --all-targets -- -D warnings

echo "▶ rustdoc"
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --quiet

echo "▶ cargo test --lib"
cargo test --lib --quiet

echo "▶ pytest (offline only)"
if [ -d gflights-py/.venv ]; then
  cd gflights-py
  .venv/bin/python -m pytest tests/test_import.py -q 2>/dev/null \
    || .venv/Scripts/python.exe -m pytest tests/test_import.py -q 2>/dev/null \
    || true
  cd ..
fi
