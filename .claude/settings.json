{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "cargo fmt \u0026\u0026 cargo clippy --all-targets -- -D warnings",
            "if": "Bash(git commit*)",
            "statusMessage": "cargo fmt + clippy...",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}